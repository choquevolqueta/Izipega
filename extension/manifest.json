{
  "manifest_version": 3,
  "name": "Izipega",
  "version": "1.0.0",
  "description": "Rellena cualquier formulario web usando tu perfil + IA (Gemini + Groq).",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8765/*"
  ],
  "action": {
    "default_title": "Izipega"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Abrir / cerrar el panel lateral"
    },
    "analizar_contexto": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Analizar contexto de la pagina"
    },
    "rellenar_formulario": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Rellenar formulario"
    },
    "forzar_rellenado": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "Re-llenar formulario (forzar)"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["revisar.html", "revisar.js", "revisar.css", "editar_perfil.html", "editar_perfil.js", "editar_perfil.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
